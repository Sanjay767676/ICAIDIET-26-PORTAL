node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Cloudflare
.wrangler/
.dev.vars
# wrangler.toml contains account_id / database_id / secrets. Not committed.
backend/wrangler.toml
backend/wrangler.toml.example

# Redundant top-level assets copy (source of truth is user-portal/src/assets/)
user-portal/assets/
*.err

# Raw production SQL/JSON dumps. These contain user password_hash values, real
# names, phone numbers, email addresses and live bank details, so they must
# never be committed. Restore locally with a `wrangler d1 export` instead.
backup/
*.sql
!backend/migrations/*.sql
# Any backup file/folder, wherever it lives (dumps, JSON exports, copies).
backend/backup_*.sql
*backup*/
backup_*/
*_backup.*
*backup_*.*
*.bak
*.old
*.orig
*~
# Generated analysis reports (Excel) — contain author names, emails and payment data.
backend/analysis/
__pycache__/
*.py[cod]
backend/scripts/*.json
backend/scripts/*.sqlite
backend/scripts/*.txt
# Local one-off Python helpers: they read PII dumps / production exports and
# hardcode local paths, so they stay on the machine that generated them.
backend/scripts/*.py

# Proceedings build output: camera-ready author PDFs, combined PDF/DOCX batches
# and generated books. Private author material, never commit it.
proceedings/
