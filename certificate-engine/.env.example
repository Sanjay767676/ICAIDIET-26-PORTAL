# Cloudflare Worker URL (same as VITE_API_URL in the portals), no trailing slash
API_URL=https://your-worker.workers.dev
# Shared secret, same value as: npx wrangler secret put CERTIFICATE_SECRET  (min 16 chars)
CERTIFICATE_SECRET=change-me-to-a-long-random-string
CERT_STYLE=A_classic
BATCH_SIZE=20
AUTO_RUN=true
